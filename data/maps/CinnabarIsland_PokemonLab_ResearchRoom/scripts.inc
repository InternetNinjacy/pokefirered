CinnabarIsland_PokemonLab_ResearchRoom_MapScripts::
	.byte 0

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OppositeFossilResearcher::
	goto_if_set FLAG_GOT_HELIX_FOSSIL, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_CheckHelixRestoration
	goto_if_set FLAG_GOT_DOME_FOSSIL, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_CheckDomeRestoration
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_CheckHelixRestoration::
	goto_if_unset FLAG_REVIVED_HELIX, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor
	goto_if_set FLAG_GOT_DOME_FOSSIL, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OfferDomeFossil
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_CheckDomeRestoration::
	goto_if_unset FLAG_REVIVED_DOME, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor
	goto_if_set FLAG_GOT_HELIX_FOSSIL, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OfferHelixFossil
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OfferDomeFossil::
	lock
	faceplayer
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_OfferDomeFossil, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_DeclineOppositeFossil
	checkitemspace ITEM_DOME_FOSSIL, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OppositeFossilBagFull
	giveitem_msg CinnabarIsland_PokemonLab_ResearchRoom_Text_ObtainedDomeFossil, ITEM_DOME_FOSSIL, 1, MUS_OBTAIN_KEY_ITEM
	setflag FLAG_GOT_DOME_FOSSIL
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_OppositeFossilAfterGift
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OfferHelixFossil::
	lock
	faceplayer
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_OfferHelixFossil, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_DeclineOppositeFossil
	checkitemspace ITEM_HELIX_FOSSIL, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OppositeFossilBagFull
	giveitem_msg CinnabarIsland_PokemonLab_ResearchRoom_Text_ObtainedHelixFossil, ITEM_HELIX_FOSSIL, 1, MUS_OBTAIN_KEY_ITEM
	setflag FLAG_GOT_HELIX_FOSSIL
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_OppositeFossilAfterGift
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_DeclineOppositeFossil::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_OppositeFossilDecline
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_OppositeFossilBagFull::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_OppositeFossilBagFull
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_MetronomeTutor::
	goto EventScript_MetronomeTutor
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_Scientist::
	lock
	faceplayer
	goto_if_set FLAG_SQ_CINNABAR_COMPLETE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchComplete
	goto_if_eq VAR_SQ_CINNABAR_STATE, 0, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchOffer
	goto_if_eq VAR_SQ_CINNABAR_STATE, 1, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchActive
	goto_if_eq VAR_SQ_CINNABAR_STATE, 2, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchReward
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchEggPending
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchOffer::
	goto_if_unset FLAG_GOT_HM03, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchNeedsSurf
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchOffer, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchDecline
	setvar VAR_SQ_CINNABAR_ITEMS, 0
	setvar VAR_SQ_CINNABAR_STATE, 1
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchAccepted
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchNeedsSurf::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchNeedsSurf
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchDecline::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchDecline
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchActive::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchActive
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchReward::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchReadyToReturn
	checkitemspace ITEM_TM17, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchBagFull
	additem ITEM_TM17, 1
	goto_if_eq VAR_RESULT, FALSE, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchBagFull
	setvar VAR_SQ_CINNABAR_STATE, 3
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchReceivedEarthquake
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchGiveEgg
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchBagFull::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchBagFull
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchEggPending::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchEggPending
	goto CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchGiveEgg
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchGiveEgg::
	giveegg SPECIES_MAGBY
	goto_if_eq VAR_RESULT, 2, CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchNoPokemonRoom
	setflag FLAG_SQ_CINNABAR_COMPLETE
	setvar VAR_SQ_CINNABAR_STATE, 4
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchRewardsComplete
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchNoPokemonRoom::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchNoPokemonRoom
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_FieldResearchComplete::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_FieldResearchComplete
	release
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_Computer::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_LegendaryBirdEmail, MSGBOX_SIGN
	end

CinnabarIsland_PokemonLab_ResearchRoom_EventScript_AmberPipe::
	msgbox CinnabarIsland_PokemonLab_ResearchRoom_Text_AnAmberPipe, MSGBOX_SIGN
	end
