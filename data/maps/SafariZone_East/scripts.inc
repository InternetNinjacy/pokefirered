SafariZone_East_MapScripts::
	.byte 0

SafariZone_East_EventScript_RestHouseSign::
	msgbox SafariZone_East_Text_RestHouse, MSGBOX_SIGN
	end

SafariZone_East_EventScript_TrainerTips::
	msgbox SafariZone_East_Text_TimeDeclinesOnlyWhileYouWalk, MSGBOX_SIGN
	end

SafariZone_East_EventScript_AreaSign::
	goto_if_eq VAR_SQ_FUCHSIA_STATE, 2, SafariZone_East_EventScript_CensusCheck
	goto_if_eq VAR_SQ_FUCHSIA_STATE, 3, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_STATE, 4, SafariZone_East_EventScript_CensusAlreadyRecorded
	msgbox SafariZone_East_Text_AreaSign, MSGBOX_SIGN
	end

SafariZone_East_EventScript_CensusCheck::
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 2, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 3, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 6, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 7, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 10, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 11, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 14, SafariZone_East_EventScript_CensusAlreadyRecorded
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 15, SafariZone_East_EventScript_CensusAlreadyRecorded
	msgbox SafariZone_East_Text_CensusClue
	msgbox SafariZone_East_Text_GuessNidorino, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SafariZone_East_EventScript_CensusWrong
	msgbox SafariZone_East_Text_GuessParasect, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SafariZone_East_EventScript_CensusCorrect
	msgbox SafariZone_East_Text_GuessRhyhorn, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SafariZone_East_EventScript_CensusWrong
	msgbox SafariZone_East_Text_GuessExeggcute, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, SafariZone_East_EventScript_CensusWrong
	goto SafariZone_East_EventScript_CensusWrong
	end

SafariZone_East_EventScript_CensusCorrect::
	msgbox SafariZone_East_Text_CensusCorrect
	addvar VAR_SQ_FUCHSIA_CENSUS_BITS, 2
	goto_if_eq VAR_SQ_FUCHSIA_CENSUS_BITS, 15, SafariZone_East_EventScript_CensusAllRecorded
	end

SafariZone_East_EventScript_CensusWrong::
	msgbox SafariZone_East_Text_CensusHint
	end

SafariZone_East_EventScript_CensusAlreadyRecorded::
	msgbox SafariZone_East_Text_CensusAlreadyRecorded, MSGBOX_SIGN
	end

SafariZone_East_EventScript_CensusAllRecorded::
	setvar VAR_SQ_FUCHSIA_STATE, 3
	msgbox SafariZone_East_Text_CensusAllRecorded, MSGBOX_SIGN
	end
