SafariZone_Center_Text_WhereDidErikGo::
    .string "SARA: Where did my boyfriend,\n"
    .string "ERIK, go?$"

SafariZone_Center_Text_CatchingMonsAsGifts::
    .string "I'm catching POKéMON to take home\n"
    .string "as gifts.$"

SafariZone_Center_Text_CensusIntro::
    .string "I'm helping keep the SAFARI ZONE's\n"
    .string "census up to date.\p"
    .string "Four monitored POKéMON have left\n"
    .string "signs around the four zones.\p"
    .string "Inspect each AREA sign, identify\n"
    .string "what left the clue, and record it.\p"
    .string "You don't need to catch anything.\p"
    .string "Bring me all four records and I'll\n"
    .string "give you a reward.$"

SafariZone_Center_Text_CensusActive::
    .string "The census is still open.\p"
    .string "Check the AREA signs in all four\n"
    .string "zones and identify each POKéMON.$"

SafariZone_Center_Text_CensusFinished::
    .string "Excellent! You recorded all four\n"
    .string "monitored POKéMON.\p"
    .string "This is for your careful fieldwork.$"

SafariZone_Center_Text_ReceivedScopeLens::
    .string "{PLAYER} received the SCOPE LENS!$"

SafariZone_Center_Text_CensusNoRoom::
    .string "Your BAG is full.\p"
    .string "Make room and come back. Your\n"
    .string "census record is safe.$"

SafariZone_Center_Text_CensusThanks::
    .string "Thanks to you, the SAFARI ZONE's\n"
    .string "census is up to date.$"

